{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Angular: iniciar Patio",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/salud-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building",
          "endsPattern": "Local:.*4387"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Angular: instalar dependencias",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/salud-web"
      },
      "problemMatcher": []
    },
    {
      "label": "Angular: compilar",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/salud-web"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Angular: pruebas",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/salud-web"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Sistema: verificación estricta",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/verify-strict.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Sistema: iniciar fixture aislada",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/start-strict-fixture.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
