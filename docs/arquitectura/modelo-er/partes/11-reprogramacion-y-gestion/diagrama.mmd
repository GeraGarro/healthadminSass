        texto motivo_cierre "opcional "
    }
    SOLICITUD_GESTION {
        uuid tenant_id FK "obligatorio ref ENTIDAD"
        uuid id PK "obligatorio UUIDv7 interno estable; generación en PostgreSQL con DEFAULT uuidv7(); ADR-015"
        uuid paciente_id FK "obligatorio ref PACIENTE"
        uuid profesional_entidad_id FK "obligatorio ref PROFESIONAL_ENTIDAD"
        uuid practica_id FK "opcional ref PRACTICA"
        uuid turno_afectado_id FK "opcional ref TURNO_AFECTADO"
        uuid solicitante_id FK "obligatorio ref CUENTA"
