erDiagram
    LOTE_REPROGRAMACION {
        uuid tenant_id FK "obligatorio ref ENTIDAD"
        uuid id PK "obligatorio UUIDv7 interno estable; generación en PostgreSQL con DEFAULT uuidv7(); ADR-015"
        uuid profesional_entidad_id FK "obligatorio ref PROFESIONAL_ENTIDAD"
        uuid iniciador_id FK "obligatorio ref CUENTA"
        texto motivo_interno "obligatorio "
        enum estado "obligatorio "
        instante creado_en "obligatorio "
        texto clave_operacion "obligatorio "
    }
    INTERVALO_LOTE {
        uuid tenant_id FK "obligatorio ref ENTIDAD"
        uuid id PK "obligatorio UUIDv7 interno estable; generación en PostgreSQL con DEFAULT uuidv7(); ADR-015"
