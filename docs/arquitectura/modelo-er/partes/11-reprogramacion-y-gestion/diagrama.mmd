        uuid agenda_id FK "obligatorio ref AGENDA"
        instante inicio "obligatorio "
        instante fin "obligatorio "
    }
    TURNO_AFECTADO {
        uuid tenant_id FK "obligatorio ref ENTIDAD"
        uuid id PK "obligatorio UUIDv7 interno estable; generación en PostgreSQL con DEFAULT uuidv7(); ADR-015"
        uuid lote_id FK "obligatorio ref LOTE_REPROGRAMACION"
