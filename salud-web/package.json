{
  "name": "salud-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4387 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "npm run test:domain && ng test --watch=false",
    "preview": "node scripts/preview.mjs",
    "test:domain": "node --test tests/*.test.mjs",
    "test:coverage": "ng test --watch=false --coverage",
    "verify": "npm test && npm run build",
    "verify:strict": "npm test && npm run test:coverage && npm audit --audit-level=moderate && npm run build"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "vite": "8.3.3"
  }
}
