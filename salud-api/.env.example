# Used by Docker Compose. Spring does not automatically read this file.
# scripts/start-local.ps1 imports it into the current server process.
POSTGRES_PASSWORD=replace-with-unique-local-admin-password
DB_PASSWORD=replace-with-unique-local-runtime-password
DB_MIGRATION_PASSWORD=replace-with-unique-local-migration-password
DB_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/salud
DB_USERNAME=salud_app
DB_MIGRATION_USERNAME=salud_migrator
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4387,http://localhost:4387
PORTAL_URL=http://127.0.0.1:4387
# start-local.ps1 genera estas claves si faltan. No usar datos reales en local.
# APP_ENCRYPTION_KEY: 32 bytes en base64, conservarla junto con los respaldos cifrados.
# BOOTSTRAP_PASSWORD: 12 a 72 caracteres; compartida solo por las cuentas demo.
# Se omiten sus valores aquí para que el script los genere.
