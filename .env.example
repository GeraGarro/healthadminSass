# scripts/start-local.ps1 creates .env with unique secrets on its first run.
POSTGRES_PASSWORD=generate-with-start-local
DB_PASSWORD=generate-with-start-local
DB_MIGRATION_PASSWORD=generate-with-start-local
APP_ENCRYPTION_KEY=generate-with-start-local
BOOTSTRAP_PASSWORD=generate-with-start-local
WEB_PORT=4387
API_PORT=8080
# Only for compose.host-api.yml; Spring must be reachable from Docker Desktop.
HOST_API_PORT=8080
# Optional: configure the matching web origin with Google before enabling it.
GOOGLE_CLIENT_ID=
